# Local development — points at self-hosted Supabase Docker stack
# Copy to .env.local and fill in VITE_SUPABASE_ANON_KEY from supabase/docker/.env
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=paste-ANON_KEY-from-supabase-docker-.env-here

# Production (Azure) — uncomment and update when deploying
# VITE_SUPABASE_URL=https://api.loadout.yourdomain.com
# VITE_SUPABASE_ANON_KEY=your-azure-anon-key
