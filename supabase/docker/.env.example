# =============================================================
# Loadout — Backend environment variables
# Copy to .env and fill in all values before running Docker.
# NEVER commit .env to git.
# =============================================================

# -------------------------------------------------------------
# Postgres
# Use a strong random password — min 20 chars
# -------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-password-here

# -------------------------------------------------------------
# JWT
# Generate at: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
#
# JWT_SECRET   — at least 32 random characters
# ANON_KEY     — JWT signed with JWT_SECRET, role=anon
# SERVICE_ROLE_KEY — JWT signed with JWT_SECRET, role=service_role
# -------------------------------------------------------------
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
ANON_KEY=paste-generated-anon-jwt-here
SERVICE_ROLE_KEY=paste-generated-service-role-jwt-here

# -------------------------------------------------------------
# Realtime
# Any long random string (32+ chars)
# -------------------------------------------------------------
SECRET_KEY_BASE=change-me-secret-key-base-at-least-32-chars
REALTIME_ENCRYPTION_KEY=change-me-realtime-encryption-key

# -------------------------------------------------------------
# URLs
# Local dev defaults — update for Azure deployment
# -------------------------------------------------------------
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:5173

# Comma-separated list of allowed redirect URLs after auth
# Add your Vercel URL here when deploying
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:4173

# -------------------------------------------------------------
# Studio dashboard credentials
# Only used for local Supabase Studio (port 3001)
# -------------------------------------------------------------
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-studio-password

# -------------------------------------------------------------
# SMTP — optional, for email auth / magic links
# Leave blank to use Supabase's built-in Inbucket (local only)
# -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@loadout.local

# Set to true during local dev to skip email confirmation
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# -------------------------------------------------------------
# Logflare — optional analytics / log drain
# Leave blank to disable
# -------------------------------------------------------------
LOGFLARE_API_KEY=
